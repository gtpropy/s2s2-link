+    str     r1, [r7, #16]           @ m = 1
+    str     r1, [r7, #20]           @ b = 1
+.Lbm_n:
+    ldr     r2, [r7, #12]           @ n
+    CTXP    r0, 32
+    ldrb    r4, [r0, r2]            @ d = S[n]
+    ldr     r5, [r7, #0]            @ L
+    movs    r6, #1                  @ i
+.Lbm_dot:
+    cmp     r6, r5
+    bhi     .Lbm_dotdone
+    CTXP    r0, 64
+    ldrb    r0, [r0, r6]            @ C[i]
+    ldr     r1, [r7, #12]
+    subs    r1, r1, r6
