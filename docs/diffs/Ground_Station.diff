+@ ============================================================================
+@ seal_core.S -- hand-written Thumb-1 (Cortex-M0+) core of the light FEC wrap.
+@
+@ Byte math over GF(256) with table lookups (seal_tables.S), 32 check bytes,
+@ shortened to 120 data + 32 check = 152 byte codewords. Corrects up to 16
+@ byte errors per codeword. Algorithm identical to fec_asm_tests/fec_model.py
+@ (cross-checked by test_seal_asm.py under an emulator).
+@
+@   void seal_encode(const uint8_t data[120], uint8_t chk[33]);
+@        chk must be 4-byte aligned, 33 bytes (chk[32] is scratch, left 0).
+@   uint32_t seal_syndromes(const uint8_t cw[152], uint8_t syn[32]);
+@        syn 4-byte aligned. Returns 0 iff all 32 syndromes are zero.
+@   int32_t seal_decode(uint8_t cw[152]);
+@        Corrects in place. Returns number of corrected bytes (0..16) or -1.
+@
+@ All routines follow the AAPCS (r4-r7 preserved, r0-r3/r12 scratch).
+@ ============================================================================
+    .syntax unified
+    .cpu cortex-m0plus
+    .thumb
+
+@ work area ("ctx") layout, 240 bytes on the caller's stack, base in r7:
+@   0 L   4 nroots   8 cw ptr   12 n/e   16 m/lx   20 b   24 d/num   (words)
+@   32 S[32]  64 C[36]  100 B[36]  136 T[36]  172 OM[16]  188 RT[16]  204 LT[17 halfwords]
+    .macro CTXP reg, off
+    mov     \reg, r7
+    adds    \reg, #\off
+    .endm
+
+    .section .text.seal_core,"ax",%progbits
+    .align 2
+
+@ ----------------------------------------------------------------------------
+@ seal_encode
+@ ----------------------------------------------------------------------------
+    .global seal_encode
+    .thumb_func
+seal_encode:
+    push    {r4-r7, lr}
+    sub     sp, #8
+    movs    r2, #120
+    adds    r2, r0, r2              @ end of data
+    str     r2, [sp]
+    movs    r2, #0                  @ zero chk[0..32]
+    str     r2, [r1, #0]
+    str     r2, [r1, #4]
+    str     r2, [r1, #8]
+    str     r2, [r1, #12]
+    str     r2, [r1, #16]
+    str     r2, [r1, #20]
+    str     r2, [r1, #24]
+    str     r2, [r1, #28]
+    movs    r3, #32
+    strb    r2, [r1, r3]
+    ldr     r4, =seal_exp
+    ldr     r5, =seal_gl
+1:                                  @ ---- per data byte ----
+    ldrb    r2, [r0]
+    adds    r0, r0, #1
+    ldrb    r3, [r1]
+    eors    r2, r3                  @ fb = d ^ chk[0]
+    beq     4f                      @ fb == 0 -> plain shift
+    lsls    r2, r2, #1
+    ldr     r3, =seal_log
+    ldrh    r2, [r3, r2]            @ r2 = log(fb)
+    movs    r7, #4
+2:                                  @ ---- 4 groups of 8 taps ----
+    ldrb    r3, [r5, #0]
+    adds    r3, r3, r2
+    ldrb    r3, [r4, r3]
+    ldrb    r6, [r1, #1]
+    eors    r3, r6
+    strb    r3, [r1, #0]
+
+    ldrb    r3, [r5, #1]
+    adds    r3, r3, r2
+    ldrb    r3, [r4, r3]
+    ldrb    r6, [r1, #2]
+    eors    r3, r6
+    strb    r3, [r1, #1]
+
+    ldrb    r3, [r5, #2]
+    adds    r3, r3, r2
+    ldrb    r3, [r4, r3]
+    ldrb    r6, [r1, #3]
+    eors    r3, r6
+    strb    r3, [r1, #2]
+
+    ldrb    r3, [r5, #3]
+    adds    r3, r3, r2
+    ldrb    r3, [r4, r3]
+    ldrb    r6, [r1, #4]
+    eors    r3, r6
+    strb    r3, [r1, #3]
+
+    ldrb    r3, [r5, #4]
+    adds    r3, r3, r2
+    ldrb    r3, [r4, r3]
+    ldrb    r6, [r1, #5]
+    eors    r3, r6
+    strb    r3, [r1, #4]
+
+    ldrb    r3, [r5, #5]
+    adds    r3, r3, r2
+    ldrb    r3, [r4, r3]
+    ldrb    r6, [r1, #6]
+    eors    r3, r6
+    strb    r3, [r1, #5]
+
+    ldrb    r3, [r5, #6]
+    adds    r3, r3, r2
+    ldrb    r3, [r4, r3]
+    ldrb    r6, [r1, #7]
+    eors    r3, r6
+    strb    r3, [r1, #6]
+
+    ldrb    r3, [r5, #7]
+    adds    r3, r3, r2
+    ldrb    r3, [r4, r3]
+    ldrb    r6, [r1, #8]
+    eors    r3, r6
+    strb    r3, [r1, #7]
+
+    adds    r1, #8
+    adds    r5, #8
+    subs    r7, #1
+    bne     2b
+    subs    r1, #32
+    subs    r5, #32
+3:                                  @ ---- next data byte ----
+    ldr     r3, [sp]
+    cmp     r0, r3
+    bne     1b
+    add     sp, #8
+    pop     {r4-r7, pc}
+4:                                  @ fb == 0: chk = chk << 1 (bytes)
+    movs    r7, #32
+5:
+    ldrb    r3, [r1, #1]
+    strb    r3, [r1, #0]
+    adds    r1, #1
+    subs    r7, #1
+    bne     5b
+    subs    r1, #32
+    b       3b
+    .ltorg
+
+@ ----------------------------------------------------------------------------
+@ seal_syndromes -- S[j] = cw(alpha^j), j = 0..31, by Horner over all 152 bytes
+@ ----------------------------------------------------------------------------
+    .global seal_syndromes
+    .thumb_func
+seal_syndromes:
+    push    {r4-r7, lr}
+    sub     sp, #8
+    movs    r2, #152
+    adds    r2, r0, r2
+    str     r2, [sp]
+    movs    r2, #0
+    str     r2, [r1, #0]
+    str     r2, [r1, #4]
+    str     r2, [r1, #8]
+    str     r2, [r1, #12]
+    str     r2, [r1, #16]
+    str     r2, [r1, #20]
+    str     r2, [r1, #24]
+    str     r2, [r1, #28]
+    ldr     r5, =seal_log
+1:                                  @ ---- per codeword byte ----
+    ldrb    r6, [r0]
+    adds    r0, r0, #1
+    mov     r2, r1
+    ldr     r4, =seal_exp
+    movs    r7, #4
+2:                                  @ ---- 4 groups of 8 syndromes ----
+    ldrb    r3, [r2, #0]
+    lsls    r3, r3, #1
+    ldrh    r3, [r5, r3]
+    adds    r3, #0
+    ldrb    r3, [r4, r3]
+    eors    r3, r6
+    strb    r3, [r2, #0]
+
+    ldrb    r3, [r2, #1]
+    lsls    r3, r3, #1
+    ldrh    r3, [r5, r3]
+    adds    r3, #1
+    ldrb    r3, [r4, r3]
+    eors    r3, r6
+    strb    r3, [r2, #1]
+
+    ldrb    r3, [r2, #2]
+    lsls    r3, r3, #1
+    ldrh    r3, [r5, r3]
+    adds    r3, #2
+    ldrb    r3, [r4, r3]
+    eors    r3, r6
+    strb    r3, [r2, #2]
+
+    ldrb    r3, [r2, #3]
+    lsls    r3, r3, #1
+    ldrh    r3, [r5, r3]
+    adds    r3, #3
+    ldrb    r3, [r4, r3]
+    eors    r3, r6
+    strb    r3, [r2, #3]
+
+    ldrb    r3, [r2, #4]
+    lsls    r3, r3, #1
+    ldrh    r3, [r5, r3]
+    adds    r3, #4
+    ldrb    r3, [r4, r3]
+    eors    r3, r6
+    strb    r3, [r2, #4]
+
+    ldrb    r3, [r2, #5]
+    lsls    r3, r3, #1
+    ldrh    r3, [r5, r3]
+    adds    r3, #5
+    ldrb    r3, [r4, r3]
+    eors    r3, r6
+    strb    r3, [r2, #5]
+
+    ldrb    r3, [r2, #6]
+    lsls    r3, r3, #1
+    ldrh    r3, [r5, r3]
+    adds    r3, #6
+    ldrb    r3, [r4, r3]
+    eors    r3, r6
+    strb    r3, [r2, #6]
+
+    ldrb    r3, [r2, #7]
+    lsls    r3, r3, #1
+    ldrh    r3, [r5, r3]
+    adds    r3, #7
+    ldrb    r3, [r4, r3]
+    eors    r3, r6
+    strb    r3, [r2, #7]
+
+    adds    r2, #8
+    adds    r4, #8
+    subs    r7, #1
+    bne     2b
+    ldr     r3, [sp]
+    cmp     r0, r3
+    bne     1b
+    movs    r0, #0                  @ return OR of all syndromes
+    ldr     r3, [r1, #0]
+    orrs    r0, r3
+    ldr     r3, [r1, #4]
+    orrs    r0, r3
+    ldr     r3, [r1, #8]
+    orrs    r0, r3
+    ldr     r3, [r1, #12]
+    orrs    r0, r3
+    ldr     r3, [r1, #16]
+    orrs    r0, r3
+    ldr     r3, [r1, #20]
+    orrs    r0, r3
+    ldr     r3, [r1, #24]
+    orrs    r0, r3
+    ldr     r3, [r1, #28]
+    orrs    r0, r3
+    add     sp, #8
+    pop     {r4-r7, pc}
+    .ltorg
+
+@ ----------------------------------------------------------------------------
+@ gf_mul: r0 = r0 * r1 (GF(256)). Clobbers r1-r3. Preserves r4-r7.
+@ gf_div: r0 = r0 / r1 (r1 != 0). Clobbers r1-r3.
+@ ----------------------------------------------------------------------------
+    .thumb_func
+gf_mul:
+    cmp     r0, #0
+    beq     1f
+    cmp     r1, #0
+    beq     2f
+    ldr     r2, =seal_log
+    lsls    r0, r0, #1
+    ldrh    r0, [r2, r0]
+    lsls    r1, r1, #1
+    ldrh    r1, [r2, r1]
+    adds    r0, r0, r1
+    ldr     r2, =seal_exp
+    ldrb    r0, [r2, r0]
+1:
+    bx      lr
+2:
+    movs    r0, #0
+    bx      lr
+
+    .thumb_func
+gf_div:
+    cmp     r0, #0
+    beq     1f
+    ldr     r2, =seal_log
+    lsls    r0, r0, #1
+    ldrh    r0, [r2, r0]
+    lsls    r1, r1, #1
+    ldrh    r1, [r2, r1]
+    movs    r3, #255
+    adds    r0, r0, r3
+    subs    r0, r0, r1
+    ldr     r2, =seal_exp
+    ldrb    r0, [r2, r0]
+1:
+    bx      lr
+    .ltorg
+
+@ ----------------------------------------------------------------------------
+@ seal_bm(ctx r0) -> r0 = L : error locator C(x) (ctx+64) from syndromes (ctx+32)
+@ ----------------------------------------------------------------------------
+    .thumb_func
+seal_bm:
+    push    {r4-r7, lr}
+    mov     r7, r0
+    movs    r1, #0                  @ zero C and B (64..135 = 18 words)
+    CTXP    r0, 64
+    movs    r2, #18
+1:
+    stmia   r0!, {r1}
+    subs    r2, #1
+    bne     1b
+    movs    r1, #1
+    CTXP    r0, 64
+    strb    r1, [r0]                @ C[0] = 1
+    CTXP    r0, 100
+    strb    r1, [r0]                @ B[0] = 1
+    movs    r1, #0
+    str     r1, [r7, #0]            @ L = 0
+    str     r1, [r7, #12]           @ n = 0
