+    adds    r0, #1
+    ldr     r1, [r7, #0]
+    subs    r0, r0, r1
+    str     r0, [r7, #0]
+    CTXP    r0, 136                 @ B = T
+    CTXP    r1, 100
+    movs    r2, #9
+1:
+    ldmia   r0!, {r3}
+    stmia   r1!, {r3}
+    subs    r2, #1
+    bne     1b
+    ldr     r0, [r7, #24]
