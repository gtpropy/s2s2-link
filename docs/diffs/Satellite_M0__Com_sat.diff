+#ifndef OBC_LED_H
+#define OBC_LED_H
+
+/*
+ * Nucleo-WL55JC LEDs (PB15 blue LD1, PB9 green LD2, PB11 red LD3, active high). Both cores drive
+ * them on the image path: CPU1 shows blue = writing flash, green = reading flash; CPU2 shows
